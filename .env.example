# ─────────────────────────────────────────────────────────────────────────────
# Tryvanta Social — environment variables
# Copy this file to .env and fill in the values marked REQUIRED.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (REQUIRED) ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://tryvanta:tryvanta@db:5432/tryvanta_social
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=development

# Generate with: openssl rand -base64 32
APP_SECRET=change-me-generate-with-openssl-rand-base64-32
DATA_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# ── AI providers (add at least one) ──────────────────────────────────────────
# The router degrades gracefully — add any subset.
# With only OLLAMA_BASE_URL the product runs fully local (classification only).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Daily AI budget cap (USD). The router stops calling providers at this limit.
AI_DAILY_BUDGET_USD=25.0

# ── Source OAuth (all optional — connect via Settings UI) ─────────────────────
# Gmail / YouTube / Google Business Profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Meta (Instagram, Messenger, WhatsApp, Facebook)
# Requires: Business Verification + app_review approval
META_APP_ID=
META_APP_SECRET=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# X (Twitter)
X_CLIENT_ID=
X_CLIENT_SECRET=

# Telegram — user pastes bot token in Settings UI; this is the webhook signature secret
TELEGRAM_WEBHOOK_SECRET=

# ── Ad platforms (Phase 7 — additional approval required) ────────────────────
# Meta Ads: requires ads_management permission via App Review
# (separate from the messaging permissions above)

# Google Ads: requires developer token + Basic Access approval
# Apply at: https://developers.google.com/google-ads/api/docs/access-levels
GOOGLE_ADS_DEVELOPER_TOKEN=

# ── App config ────────────────────────────────────────────────────────────────
# OAuth callback base URL (must match what's registered with each provider)
OAUTH_REDIRECT_BASE=http://localhost:8000/v1/channels/callback

# Webhook verification token (Meta / Slack subscription challenge)
WEBHOOK_VERIFY_TOKEN=tryvanta-verify

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Production only ───────────────────────────────────────────────────────────
# These are ignored in development.
# ACME_EMAIL=your@email.com
# DOMAIN=app.tryvanta.social
# POSTGRES_USER=tryvanta
# POSTGRES_PASSWORD=<strong-password>
# REDIS_PASSWORD=<strong-password>
# GRAFANA_PASSWORD=<strong-password>
# REPO=your-github-org/tryvanta-social
# VERSION=v1.0.0
